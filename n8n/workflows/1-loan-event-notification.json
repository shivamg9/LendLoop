  "active": false,
  "nodes": [
    {
      "id": "eecdad43-06f3-5796-8cb7-e45a642f5b5f",
      "name": "Loan event webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
