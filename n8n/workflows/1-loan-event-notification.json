    },
    {
      "id": "6ac929c8-524e-551d-b6b8-ebe3fa9a54b2",
      "name": "Verify signature",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ],
      "parameters": {
        "jsCode": "// Verifies the signature over the EXACT raw request body (Webhook \"Raw Body\" option),\n// using a constant-time comparison, and rejects timestamps outside a 5-minute window.\nconst crypto = require('crypto');\nconst MAX_SKEW_SECONDS = 300;\nconst secret = $env.LENDLOOP_WEBHOOK_SECRET;\nif (!secret) throw new Error('LENDLOOP_WEBHOOK_SECRET is not set'); // fail closed\n\nconst headers = $input.first().json.headers ?? {};\nconst timestamp = String(headers['x-lendloop-timestamp'] ?? '');\nconst signature = String(headers['x-lendloop-signature'] ?? '');\nconst rawBody = (await this.helpers.getBinaryDataBuffer(0, 'data')).toString('utf8');\n\nfunction failureReason() {\n  if (!/^\\d{1,12}$/.test(timestamp) || !/^[0-9a-f]{64}$/i.test(signature)) return 'missing_or_malformed_headers';\n  if (Math.abs(Math.floor(Date.now() / 1000) - Number(timestamp)) > MAX_SKEW_SECONDS) return 'stale_timestamp';\n  const expected = crypto.createHmac('sha256', secret).update(`${timestamp}.${rawBody}`).digest();\n  return crypto.timingSafeEqual(expected, Buffer.from(signature, 'hex')) ? null : 'bad_signature';\n}\n\nconst reason = failureReason();\nreturn [{ json: { valid: reason === null, reason, event: reason === null ? JSON.parse(rawBody) : null } }];"
      }
    },
    {
      "id": "5e8c6da8-6041-5098-bc91-ea0a0ebeea75",
      "name": "Signature valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "193d1ff9-20a8-5fda-8bc7-0321601c16bc",
              "leftValue": "={{ $json.valid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "07adf141-bf91-52b7-af73-7e8c3b3dfdf6",
      "name": "Build notification",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        200
      ],
      "parameters": {
        "jsCode": "// Turns a data-minimized loan event into a channel-agnostic message (to/subject/text).\nconst e = $json.event;\nconst dates = `${e.startDate} to ${e.endDate}`;\nconst messages = {\n  'loan.requested': [`New request to borrow your ${e.toolName}`, `Someone would like to borrow your ${e.toolName} from ${dates}. Open LendLoop to approve or decline.`],\n  'loan.approved':  [`Your request for ${e.toolName} was approved`, `Good news: your request to borrow ${e.toolName} (${dates}) was approved.`],\n  'loan.declined':  [`Your request for ${e.toolName} was declined`, `Your request to borrow ${e.toolName} (${dates}) was declined.`],\n  'loan.cancelled': [`A request for your ${e.toolName} was cancelled`, `The request to borrow your ${e.toolName} (${dates}) was cancelled by the borrower.`],\n  'loan.returned':  [`${e.toolName} marked as returned`, `Thanks for returning ${e.toolName}. The loan is now closed.`],\n};\nconst [subject, body] = messages[e.eventType] ?? [`LendLoop update: ${e.toolName}`, `Status is now ${e.status}.`];\nreturn { json: { eventId: e.eventId, eventType: e.eventType, to: e.recipientEmail, subject, text: `Hi ${e.recipientFirstName},\\n\\n${body}\\n\\n\u2014 LendLoop` } };",
        "mode": "runOnceForEachItem"
      }
    },
    {
      "id": "7389315a-5002-532a-b29d-9918002c4abe",
