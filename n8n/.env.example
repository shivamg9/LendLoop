# Copy to n8n/.env (gitignored). docker compose reads it for variable substitution.

# Same value as the Convex env var LENDLOOP_WEBHOOK_SECRET. Generate with: openssl rand -hex 32
LENDLOOP_WEBHOOK_SECRET=
# Convex HTTP actions base URL as seen from inside the container.
#   local Convex backend: http://host.docker.internal:3211
#   cloud deployment:     https://<deployment>.convex.site
CONVEX_SITE_URL=http://host.docker.internal:3211
# Encrypts n8n's stored credentials. Generate with: openssl rand -hex 24
N8N_ENCRYPTION_KEY=
